<script>
  // Custom cursor
  const cursor = document.getElementById('cursor');
  const ring = document.getElementById('cursorRing');
  let mx = 0, my = 0, rx = 0, ry = 0;
  document.addEventListener('mousemove', e => { mx = e.clientX; my = e.clientY; });
  function animateCursor() {
    cursor.style.left = mx + 'px'; cursor.style.top = my + 'px';
    rx += (mx - rx) * 0.12; ry += (my - ry) * 0.12;
    ring.style.left = rx + 'px'; ring.style.top = ry + 'px';
    requestAnimationFrame(animateCursor);
  }
  animateCursor();
  document.querySelectorAll('a,button,.product-card,.swatch,.garment-option,.font-option,.pos-btn').forEach(el => {
    el.addEventListener('mouseenter', () => { cursor.style.width='18px'; cursor.style.height='18px'; ring.style.width='52px'; ring.style.height='52px'; });
    el.addEventListener('mouseleave', () => { cursor.style.width='10px'; cursor.style.height='10px'; ring.style.width='36px'; ring.style.height='36px'; });
  });

  // Scroll reveals
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if(e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.15 });
  document.querySelectorAll('.reveal').forEach(el => observer.observe(el));

  // Customizer logic
  const prices = { 'Velocity Jacket': 285, 'Training Tee': 95, 'Compression Set': 160, 'Performance Shorts': 120, 'Sport Hoodie': 195, 'Training Vest': 145 };
  const customFee = 50;
  let currentGarment = 'Velocity Jacket';
  let customText = '';

  function selectGarment(el, name) {
    document.querySelectorAll('.garment-option').forEach(o => o.classList.remove('active'));
    el.classList.add('active');
    currentGarment = name;
    document.getElementById('garmentName').textContent = name;
    updatePrice();
  }

  function selectColor(el, name, c1, c2) {
    document.querySelectorAll('.swatch').forEach(s => s.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('colorName').textContent = name;
    document.getElementById('gradStop1').setAttribute('stop-color', c1);
    document.getElementById('gradStop2').setAttribute('stop-color', c2);
    // Update collar for white garment
    if(name === 'Ivory White') {
      document.getElementById('previewCollar').setAttribute('fill','#888');
    } else {
      document.getElementById('previewCollar').setAttribute('fill','#111');
    }
  }

  const positions = [
    {x:'80',y:'130'},{x:'130',y:'115'},{x:'180',y:'130'},
    {x:'85',y:'175'},{x:'130',y:'185'},{x:'175',y:'175'},
    {x:'85',y:'250'},{x:'130',y:'260'},{x:'175',y:'250'}
  ];
  function setPos(el, idx) {
    document.querySelectorAll('.pos-btn').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    const p = positions[idx];
    const t = document.getElementById('previewText');
    t.setAttribute('x', p.x);
    t.setAttribute('y', p.y);
  }

  function updateText(val) {
    customText = val;
    document.getElementById('previewText').textContent = val || 'APEX';
    updatePrice();
  }

  function selectFont(el, font) {
    document.querySelectorAll('.font-option').forEach(b => b.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('previewText').style.fontFamily = `'${font}', sans-serif`;
  }

  function updatePrice() {
    const base = prices[currentGarment] || 285;
    const total = base + (customText.trim() ? customFee : 0);
    document.getElementById('totalPrice').textContent = '$' + total;
  }

  function addToCart() {
    const btn = document.querySelector('.btn-order');
    btn.textContent = '✓ Added to Cart';
    btn.style.background = '#2d5a27';
    setTimeout(() => {
      btn.textContent = 'Add Custom Piece to Cart';
      btn.style.background = '';
    }, 2500);
  }
</script>
