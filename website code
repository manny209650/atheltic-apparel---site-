<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>APEX — Athletic Luxury</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Bebas+Neue&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --black: #080808;
    --off-white: #f2efea;
    --gold: #c9a84c;
    --gold-light: #e8d5a3;
    --charcoal: #1a1a1a;
    --mid: #3a3a3a;
    --muted: #888;
    --accent: #c9a84c;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    background: var(--black);
    color: var(--off-white);
    font-family: 'DM Sans', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
    cursor: none;
  }

  /* Custom cursor */
  .cursor {
    position: fixed;
    width: 10px; height: 10px;
    background: var(--gold);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transform: translate(-50%, -50%);
    transition: transform 0.1s ease, width 0.3s, height 0.3s, background 0.3s;
  }
  .cursor-ring {
    position: fixed;
    width: 36px; height: 36px;
    border: 1px solid rgba(201,168,76,0.5);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: transform 0.18s ease, width 0.3s, height 0.3s;
  }
  body:hover .cursor { opacity: 1; }

  /* Grain overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    pointer-events: none;
    z-index: 9997;
    opacity: 0.35;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0;
    z-index: 1000;
    display: flex; align-items: center; justify-content: space-between;
    padding: 28px 60px;
    background: linear-gradient(to bottom, rgba(8,8,8,0.95) 0%, transparent 100%);
  }
  .nav-logo {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    letter-spacing: 0.15em;
    color: var(--off-white);
    text-decoration: none;
  }
  .nav-logo span { color: var(--gold); }
  .nav-links { display: flex; gap: 40px; list-style: none; }
  .nav-links a {
    font-size: 0.72rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--gold); }
  .nav-cta {
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--black);
    background: var(--gold);
    padding: 10px 24px;
    text-decoration: none;
    transition: background 0.3s, transform 0.2s;
  }
  .nav-cta:hover { background: var(--gold-light); transform: translateY(-1px); }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    overflow: hidden;
  }
  .hero-left {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 160px 60px 100px;
    position: relative;
    z-index: 2;
  }
  .hero-eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 24px;
    opacity: 0;
    animation: fadeUp 0.8s ease 0.3s forwards;
  }
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(4rem, 7vw, 7rem);
    font-weight: 300;
    line-height: 0.92;
    letter-spacing: -0.01em;
    margin-bottom: 32px;
    opacity: 0;
    animation: fadeUp 0.9s ease 0.5s forwards;
  }
  .hero-title em {
    font-style: italic;
    color: var(--gold);
  }
  .hero-sub {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.8;
    max-width: 340px;
    margin-bottom: 48px;
    opacity: 0;
    animation: fadeUp 0.9s ease 0.7s forwards;
  }
  .hero-actions {
    display: flex; gap: 16px; align-items: center;
    opacity: 0;
    animation: fadeUp 0.9s ease 0.9s forwards;
  }
  .btn-primary {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    background: var(--gold);
    color: var(--black);
    padding: 16px 36px;
    border: none;
    cursor: none;
    text-decoration: none;
    transition: background 0.3s, transform 0.2s;
    display: inline-block;
  }
  .btn-primary:hover { background: var(--gold-light); transform: translateY(-2px); }
  .btn-ghost {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border: 1px solid rgba(242,239,234,0.25);
    color: var(--off-white);
    padding: 15px 36px;
    text-decoration: none;
    transition: border-color 0.3s, color 0.3s;
    display: inline-block;
    cursor: none;
  }
  .btn-ghost:hover { border-color: var(--gold); color: var(--gold); }

  .hero-right {
    position: relative;
    overflow: hidden;
  }
  .hero-visual {
    position: absolute; inset: 0;
    background: linear-gradient(135deg, #1a1a1a 0%, #0d0d0d 50%, #111 100%);
    display: flex; align-items: center; justify-content: center;
  }
  .hero-garment-preview {
    width: 340px; height: 440px;
    position: relative;
  }
  /* SVG athletic shirt illustration */
  .garment-svg { width: 100%; height: 100%; filter: drop-shadow(0 40px 80px rgba(0,0,0,0.8)); }
  .hero-scroll-hint {
    position: absolute; bottom: 40px; left: 60px;
    display: flex; align-items: center; gap: 12px;
    font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--muted);
    opacity: 0; animation: fadeIn 1s ease 1.4s forwards;
  }
  .scroll-line { width: 40px; height: 1px; background: var(--gold); }

  /* MARQUEE */
  .marquee-strip {
    border-top: 1px solid rgba(201,168,76,0.2);
    border-bottom: 1px solid rgba(201,168,76,0.2);
    padding: 14px 0;
    overflow: hidden;
    background: var(--charcoal);
  }
  .marquee-track {
    display: flex; gap: 60px;
    animation: marquee 18s linear infinite;
    white-space: nowrap;
  }
  .marquee-item {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 0.9rem;
    letter-spacing: 0.3em;
    color: var(--muted);
    flex-shrink: 0;
  }
  .marquee-item span { color: var(--gold); margin-right: 60px; }

  /* PRODUCTS */
  .section { padding: 120px 60px; }
  .section-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 64px;
  }
  .section-label {
    font-size: 0.62rem; letter-spacing: 0.35em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 12px;
  }
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 300;
    line-height: 1;
  }
  .section-title em { font-style: italic; color: var(--gold); }
  .view-all {
    font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--muted); text-decoration: none; border-bottom: 1px solid var(--muted);
    padding-bottom: 2px; transition: color 0.3s, border-color 0.3s;
  }
  .view-all:hover { color: var(--gold); border-color: var(--gold); }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .product-card {
    position: relative; overflow: hidden;
    background: var(--charcoal);
    cursor: none;
  }
  .product-visual {
    height: 420px;
    background: linear-gradient(180deg, #222 0%, #111 100%);
    display: flex; align-items: center; justify-content: center;
    position: relative;
    overflow: hidden;
    transition: transform 0.6s cubic-bezier(0.25,0.46,0.45,0.94);
  }
  .product-card:hover .product-visual { transform: scale(1.04); }
  .product-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.7) 0%, transparent 60%);
  }
  .product-badge {
    position: absolute; top: 20px; left: 20px;
    font-size: 0.58rem; letter-spacing: 0.25em; text-transform: uppercase;
    background: var(--gold); color: var(--black);
    padding: 5px 12px;
  }
  .product-icon {
    width: 160px; height: 200px;
    opacity: 0.85;
    transition: opacity 0.4s, transform 0.4s;
  }
  .product-card:hover .product-icon { opacity: 1; transform: translateY(-8px); }
  .product-info {
    padding: 24px 28px 28px;
    display: flex; justify-content: space-between; align-items: flex-start;
  }
  .product-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; font-weight: 400;
    margin-bottom: 4px;
  }
  .product-category {
    font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted);
  }
  .product-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.3rem; color: var(--gold); font-weight: 300;
  }
  .product-customize-btn {
    position: absolute; bottom: 80px; left: 50%; transform: translateX(-50%) translateY(20px);
    background: var(--gold); color: var(--black);
    font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase;
    padding: 10px 24px; border: none; cursor: none;
    opacity: 0; transition: opacity 0.3s, transform 0.3s;
    white-space: nowrap;
  }
  .product-card:hover .product-customize-btn { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* CUSTOMIZER */
  #customizer {
    padding: 120px 60px;
    background: var(--charcoal);
  }
  .customizer-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-top: 64px;
  }
  .customizer-preview {
    position: sticky; top: 120px;
    background: linear-gradient(135deg, #1e1e1e, #111);
    border: 1px solid rgba(201,168,76,0.15);
    padding: 60px 40px;
    display: flex; flex-direction: column; align-items: center;
    gap: 24px;
  }
  .preview-label {
    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--muted);
  }
  .preview-garment {
    width: 260px; height: 320px;
    display: flex; align-items: center; justify-content: center;
    position: relative;
  }
  .preview-svg { width: 100%; height: 100%; transition: all 0.4s ease; }
  .preview-color-label {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.1rem; color: var(--gold);
  }

  .customizer-controls { display: flex; flex-direction: column; gap: 48px; }
  .control-group { }
  .control-title {
    font-size: 0.62rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(201,168,76,0.15);
  }

  /* Garment selector */
  .garment-options {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px;
  }
  .garment-option {
    border: 1px solid rgba(255,255,255,0.08);
    padding: 16px 12px;
    text-align: center;
    cursor: none;
    transition: border-color 0.3s, background 0.3s;
    background: transparent;
  }
  .garment-option:hover, .garment-option.active {
    border-color: var(--gold);
    background: rgba(201,168,76,0.06);
  }
  .garment-option-icon { font-size: 1.5rem; margin-bottom: 6px; }
  .garment-option-name {
    font-size: 0.65rem; letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--muted); transition: color 0.3s;
  }
  .garment-option.active .garment-option-name { color: var(--gold); }

  /* Color swatches */
  .color-swatches { display: flex; flex-wrap: wrap; gap: 12px; }
  .swatch {
    width: 36px; height: 36px;
    border-radius: 50%;
    cursor: none;
    border: 2px solid transparent;
    transition: transform 0.2s, border-color 0.2s;
    position: relative;
  }
  .swatch:hover { transform: scale(1.15); }
  .swatch.active { border-color: var(--gold); }
  .swatch.active::after {
    content: '';
    position: absolute; inset: 4px;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.5);
  }

  /* Text customization */
  .text-input-group { display: flex; flex-direction: column; gap: 12px; }
  .custom-input {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.1);
    color: var(--off-white);
    font-family: 'DM Sans', sans-serif;
    font-size: 0.85rem;
    padding: 14px 18px;
    outline: none;
    transition: border-color 0.3s;
    width: 100%;
  }
  .custom-input:focus { border-color: var(--gold); }
  .custom-input::placeholder { color: var(--muted); }

  /* Font options */
  .font-options { display: flex; gap: 10px; flex-wrap: wrap; }
  .font-option {
    padding: 8px 18px;
    border: 1px solid rgba(255,255,255,0.1);
    font-size: 0.75rem;
    cursor: none;
    transition: border-color 0.3s, color 0.3s;
    color: var(--muted);
    background: transparent;
  }
  .font-option:hover, .font-option.active {
    border-color: var(--gold); color: var(--gold);
  }

  /* Position selector */
  .position-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;
    max-width: 200px;
  }
  .pos-btn {
    aspect-ratio: 1;
    border: 1px solid rgba(255,255,255,0.08);
    background: transparent;
    cursor: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .pos-btn:hover, .pos-btn.active {
    background: rgba(201,168,76,0.12);
    border-color: var(--gold);
  }

  .customizer-cta {
    margin-top: 8px;
    display: flex; flex-direction: column; gap: 12px;
  }
  .price-summary {
    display: flex; justify-content: space-between; align-items: center;
    padding: 16px 0;
    border-top: 1px solid rgba(201,168,76,0.15);
    border-bottom: 1px solid rgba(201,168,76,0.15);
    margin-bottom: 8px;
  }
  .price-label { font-size: 0.62rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); }
  .price-total {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.8rem; color: var(--gold);
  }
  .btn-order {
    width: 100%;
    background: var(--gold);
    color: var(--black);
    font-size: 0.7rem; letter-spacing: 0.25em; text-transform: uppercase;
    padding: 18px;
    border: none; cursor: none;
    transition: background 0.3s, transform 0.2s;
  }
  .btn-order:hover { background: var(--gold-light); transform: translateY(-2px); }

  /* STATS */
  .stats-strip {
    padding: 80px 60px;
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: 2px;
    background: var(--black);
  }
  .stat-item {
    padding: 40px 40px;
    background: var(--charcoal);
    text-align: center;
  }
  .stat-number {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 3.5rem; letter-spacing: 0.05em;
    color: var(--gold);
    display: block;
  }
  .stat-label {
    font-size: 0.62rem; letter-spacing: 0.25em; text-transform: uppercase;
    color: var(--muted); margin-top: 8px;
  }

  /* FOOTER */
  footer {
    background: var(--charcoal);
    padding: 80px 60px 40px;
    border-top: 1px solid rgba(201,168,76,0.12);
  }
  .footer-top {
    display: grid; grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: 60px; margin-bottom: 60px;
  }
  .footer-brand .nav-logo { display: block; margin-bottom: 16px; font-size: 1.8rem; }
  .footer-desc { font-size: 0.78rem; color: var(--muted); line-height: 1.8; max-width: 280px; }
  .footer-col-title {
    font-size: 0.6rem; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--gold); margin-bottom: 20px;
  }
  .footer-links { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .footer-links a {
    font-size: 0.78rem; color: var(--muted); text-decoration: none; transition: color 0.3s;
  }
  .footer-links a:hover { color: var(--off-white); }
  .footer-bottom {
    display: flex; justify-content: space-between; align-items: center;
    padding-top: 32px; border-top: 1px solid rgba(255,255,255,0.06);
    font-size: 0.65rem; color: var(--muted); letter-spacing: 0.1em;
  }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; } to { opacity: 1; }
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  .float { animation: float 5s ease-in-out infinite; }

  /* Intersection observer reveal */
  .reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.8s ease, transform 0.8s ease; }
  .reveal.visible { opacity: 1; transform: translateY(0); }
</style>
</head>
<body>

<div class="cursor" id="cursor"></div>
<div class="cursor-ring" id="cursorRing"></div>

<!-- NAV -->
<nav>
  <a href="#" class="nav-logo">APE<span>X</span></a>
  <ul class="nav-links">
    <li><a href="#collections">Collections</a></li>
    <li><a href="#customizer">Customize</a></li>
    <li><a href="#about">About</a></li>
    <li><a href="#contact">Contact</a></li>
  </ul>
  <a href="#customizer" class="nav-cta">Design Yours</a>
</nav>

<!-- HERO -->
<section class="hero">
  <div class="hero-left">
    <p class="hero-eyebrow">Performance Elevated</p>
    <h1 class="hero-title">Wear<br><em>Nothing</em><br>Ordinary</h1>
    <p class="hero-sub">Athletic apparel engineered for elite performance, designed for those who refuse to compromise on aesthetics.</p>
    <div class="hero-actions">
      <a href="#collections" class="btn-primary">Shop Collection</a>
      <a href="#customizer" class="btn-ghost">Customize Now</a>
    </div>
  </div>
  <div class="hero-right">
    <div class="hero-visual">
      <div class="hero-garment-preview float">
        <svg class="garment-svg" viewBox="0 0 340 440" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Athletic jacket/top -->
          <defs>
            <linearGradient id="heroGrad" x1="0" y1="0" x2="340" y2="440" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#c9a84c" stop-opacity="0.9"/>
              <stop offset="100%" stop-color="#8a6f28" stop-opacity="0.7"/>
            </linearGradient>
            <linearGradient id="darkGrad" x1="0" y1="0" x2="340" y2="440" gradientUnits="userSpaceOnUse">
              <stop offset="0%" stop-color="#2a2a2a"/>
              <stop offset="100%" stop-color="#111"/>
            </linearGradient>
            <filter id="glow">
              <feGaussianBlur stdDeviation="8" result="blur"/>
              <feComposite in="SourceGraphic" in2="blur" operator="over"/>
            </filter>
          </defs>
          <!-- Body -->
          <path d="M90 80 L50 160 L30 380 L310 380 L290 160 L250 80 Z" fill="url(#heroGrad)" opacity="0.95"/>
          <!-- Collar -->
          <path d="M130 80 Q170 110 210 80 L220 60 Q170 40 120 60 Z" fill="url(#darkGrad)" opacity="0.9"/>
          <!-- Left sleeve -->
          <path d="M90 80 L20 140 L40 200 L100 160 Z" fill="url(#heroGrad)" opacity="0.8"/>
          <!-- Right sleeve -->
          <path d="M250 80 L320 140 L300 200 L240 160 Z" fill="url(#heroGrad)" opacity="0.8"/>
          <!-- Center stripe -->
          <path d="M155 110 L155 375 L185 375 L185 110 Z" fill="rgba(0,0,0,0.2)"/>
          <!-- APEX text on chest -->
          <text x="170" y="230" font-family="'Bebas Neue',sans-serif" font-size="28" fill="rgba(8,8,8,0.6)" text-anchor="middle" letter-spacing="6">APEX</text>
          <!-- Subtle shine -->
          <path d="M100 90 Q170 70 240 90 L250 200 Q170 180 90 200 Z" fill="rgba(255,255,255,0.05)"/>
        </svg>
      </div>
    </div>
  </div>
  <div class="hero-scroll-hint">
    <span class="scroll-line"></span>
    <span>Scroll to explore</span>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-strip">
  <div class="marquee-track">
    <span class="marquee-item"><span>✦</span> PERFORMANCE APPAREL</span>
    <span class="marquee-item"><span>✦</span> CUSTOM GARMENTS</span>
    <span class="marquee-item"><span>✦</span> LUXURY ATHLETIC WEAR</span>
    <span class="marquee-item"><span>✦</span> MADE TO ORDER</span>
    <span class="marquee-item"><span>✦</span> ELITE CRAFTSMANSHIP</span>
    <span class="marquee-item"><span>✦</span> PERFORMANCE APPAREL</span>
    <span class="marquee-item"><span>✦</span> CUSTOM GARMENTS</span>
    <span class="marquee-item"><span>✦</span> LUXURY ATHLETIC WEAR</span>
    <span class="marquee-item"><span>✦</span> MADE TO ORDER</span>
    <span class="marquee-item"><span>✦</span> ELITE CRAFTSMANSHIP</span>
  </div>
</div>

<!-- PRODUCTS -->
<section class="section" id="collections">
